# === Fleet_SIH ===
# Its own independent, already-published git repository (read-only for
# this project — never modified from here). Tracking it from the root
# repo too would duplicate its history/nested .git; ignore it entirely.
Fleet_SIH/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
wheels/
*.egg

# === Virtual environments ===
.venv/
venv/
env/
ENV/

# === Test / lint / type-check caches ===
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# === Jupyter ===
.ipynb_checkpoints/

# === Generated warehouse layouts & reports (warehouse_layout) ===
# Regenerable via `examples/generate_batch.py` / the dashboard's Create
# Layout tab — kept out of version control since the library is large
# (100+ JSON files) and reproducible from the generator + a seed.
# Remove these two lines if you'd rather version the layout library
# itself (e.g. to pin a specific known-good set of test layouts).
warehouse_layout/outputs/
warehouse_layout/build/

# === Simulation outputs & ML artifacts (fleetnet_sim) ===
# Runs/datasets/models are regenerated by `simulate`/`batch`/
# `export-dataset`/`train-model` against Postgres — the database, not
# these files, is the durable record. GIFs are replay exports.
fleetnet_sim/outputs/
*.gif
*.parquet
*.pkl
*.joblib

# === Local database data (if ever bind-mounted instead of a named volume) ===
pgdata/
*.pgdata

# === Environment / secrets ===
.env
.env.*
*.pem
*.key

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo

# === OS cruft ===
.DS_Store
Thumbs.db

